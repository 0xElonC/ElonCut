# Auto detect text files and perform LF normalization
* text=auto

# Third-party crates carried with a patch (see src/patches/README.md):
# upstream code, so GitHub's language bar counts Concat's own.
src/patches/** linguist-vendored

# Scripts keep the line endings their shell needs, whatever the checkout
# machine does: a batch file or a PowerShell script with LF alone, or a
# shell script with CRLF, fails in ways that are hard to read.
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
